#!/bin/sh
# EisGreis, the tomogram viewer, from this install (see launch.sh for what it sets up first).
#
# Run it in the folder where the comments CSV, the particle STARs and the PNGs should go, from a terminal in a remote
# desktop (an Open OnDemand Remote Desktop: about 16 GB for a 1k x 1k x 512 tomogram, 24 GB or more keeps its FFT):
#
#     eisgreis [volume.mrc ...] [--profile hpc|pc] [--workers N] [--no-spectrum-cache]
here=$(dirname "$(readlink -f "$0")")
command=eisgreis
. "$here/launch.sh"
